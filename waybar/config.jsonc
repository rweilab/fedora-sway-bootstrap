{
  "reload_style_on_change": true,
  "position": "top",
  "mod": "dock",
  "margin-top": 0,
  "height": 20,
  "margin-left": 0,
  "margin-right": 0,
  "margin-bottom": 0,


"group/left1": {
    "orientation": "inherit",
    "modules": [
      "cpu",
      "memory"
      ]
  },
  "group/left2": {
	  "orientation": "inherit",
	  "modules": ["sway/window"]
  },
  "group/left3": {
	  "orientation": "inherit",
	  "modules": ["clock", "idle_inhibitor"]
  },

  "group/right1": {
	  "orientation": "inherit",
	  "modules": [
		  "group/tray-expander",
		  "backlight",
		  "bluetooth",
		  "pulseaudio#output",
		  "pulseaudio#input",
		  "network"
	  ]
  },
  "group/right2": {
	  "orientation": "inherit",
	  "modules": [
		  "power-profiles-daemon",
		  "battery"
	  ]
  },

  "modules-left": ["group/left1", "group/left2", "group/left3"],
  "modules-center": ["sway/workspaces", "sway/mode", "sway/scratchpad"],
  "modules-right": ["group/right1", "group/right2"],

   "hyprland/window": {
    "format": "{title} - {class}",
    "max-length": 55,
    "rewrite": {
      " - ": "", // if no window is focused, a single dash is displayed, this removes it
      "(.*?) - Chromium - chromium": "   $1 ",
      "(.*chrome)...(.*)": "   $1 ",
      "(.*) - Obsidian - .* - obsidian": "   $1 ",
      "(.*nvim)...(.*)": "   $2 ",
      "(.*code) - (.*)": " 󰨞  $1 ",
      "^.*btop( .*|$)": " 󰧨 BTOP $1 ",
      "^.*cmatrix( .*|$)": " 󰘨 MATRIX $1 ",
      "(.*) - Spotify": "  $1 ",
      "(.*) - com.mitchellh.ghostty": " 󰊠 $1 ",
      "(.*) - Alacritty": "   $1 ",
      "(.*) - BeeperTexts": " 󰻞  $1 ",
      "(.*Discord)...(.*).. (.*)": "   $2 ",
      "(.*) - org.gnome.Nautilus": " 󰣆  $1 ",
      "(.*) - fish": "   [$1] ",
      "(.*Steam)...(.*)": "   $1",
      "(.*imv)...(.*).. (.*)": "   $2",
      "(.*) - com.obsproject.Studio": "  $1 "
    }
  },
  "sway/window": {
    "max-length": 16,
  },
 "cpu": {
    "interval": 10,
    "format": "{usage}% 󰍛",
    "format-alt": "{icon0}{icon1}{icon2}{icon3}",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
  },
  "memory": {
    "states": {
      "c": 90,
      "h": 60,
      "m": 30
    },
    "interval": 30,
    "format": "{percentage}%  ",
    "max-length": 10,
    "tooltip": true,
    //"tooltip-format": "\udb83\udf86 {percentage}%\n\ue266 {used:0.1f}GB/{total:0.1f}GB",
    "tooltip-format": "\udb83\udf86 Memory usage: {percentage}%\n\ue266 Used: {used:0.2f}GB / {total:0.2f}GB\n\uf85a Available: {avail:0.2f}GB\n\uf233 Swap used: {swapUsed:0.2f}GB / {swapTotal:0.2f}GB ({swapPercentage}%)"
  },
  "clock": {
    "format": " {:%F  %R}",
    "format-alt": " {:%d/%m/%Y  %H:%M}",
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "mode-mon-col": 3,
      "on-click-right": "mode",
      "format": {
        "month": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    },
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
    "activated": "󰛊",
      "deactivated": "󰾫"
    }
  },
  "network": {
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "nospacing": 1,
  },
    "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
    "default": "",
    "performance": "",
    "balanced": " ",
    "power-saver": ""
    }
  },
  "battery": {
    "interval": 5, // checks every X seconds now
    "states": {
      // "good": 95,
      // "warning": 30,
      // "critical": 20
    },
    "format": "{capacity}% {icon}  {time}  {power}W",
    "rotate": 0,
    "format-charging": "{capacity}%   {time}",
    "format-plugged": " {capacity}%",
    "format-alt": "{time} {icon}",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },
  // "battery": {
  //   "format": "{capacity}% {icon}",
  //   "format-discharging": "{capacity}% {icon}",
  //   "format-charging": "{icon}",
  //   "format-plugged": "",
  //   "format-icons": {
  //     "charging": [
  //       "󰢜",
  //       "󰂆",
  //       "󰂇",
  //       "󰂈",
  //       "󰢝",
  //       "󰂉",
  //       "󰢞",
  //       "󰂊",
  //       "󰂋",
  //       "󰂅"
  //     ],
  //     "default": [
  //       "󰁺",
  //       "󰁻",
  //       "󰁼",
  //       "󰁽",
  //       "󰁾",
  //       "󰁿",
  //       "󰂀",
  //       "󰂁",
  //       "󰂂",
  //       "󰁹"
  //     ]
  //   },
  //   "format-full": "󰂅",
  //   "tooltip-format-discharging": "{power:>1.0f}W↓ {timeTo}",
  //   "tooltip-format-charging": "{power:>1.0f}W↑ {timeTo}",
  //   "interval": 5,
  //   "on-click": "omarchy-menu power",
  //   "on-click-right": "notify-send -u low \"$(omarchy-battery-status)\"",
  //   "states": {
  //     "warning": 20,
  //     "critical": 10
  //   }
  // },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "",
    "tooltip-format": "Devices connected: {num_connections}",
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon}",
    "tooltip-format": "{percent}%",
    "format-icons": [
      "🌑",
      "🌘",
      "🌗",
      "🌖",
      "🌕"
    ]
  },
  "pulseaudio#input": {
    "format-source": "",
    "format-source-muted": " ",
    "format": "{format_source}",
    "tooltip-format": "{format_source} {source_volume}%",
    "scroll-step": 1,
    "smooth-scrolling-threshold": 1,
    "max-volume": 100,
    // "on-click": "omarchy-launch-or-focus-tui wiremix",
    "on-click-right": "pamixer -t",
    "on-scroll-up": "pactl set-source-volume @DEFAULT_SOURCE@ +1%",
    "on-scroll-down": "pactl set-source-volume @DEFAULT_SOURCE@ -1%",
},
"pulseaudio#output": {
    "format": "{icon}",
    "tooltip-format": "{icon}  {volume}%",
    "format-muted": " off",
    "format-icons": {
        "default": [""]
    },
    "max-volume": 100,
    "scroll-step": 2,
    "smooth-scrolling-threshold": 1,
    // "on-click": "omarchy-launch-or-focus-tui wiremix",
    "on-click-right": "pamixer -t"
},
 "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": [
      "custom/expand-icon",
      "tray"
    ]
  },
  "custom/expand-icon": {
    "format": "  ",
    "tooltip": false
  },
  "tray": {
    "icon-size": 12,
    "spacing": 12
  },
  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "<span color='grey'>{status_icon} {dynamic}</span>",
    "max-length": 50,
    "interval": 1,
    "player-icons": {
      "default": "⏸",
      "mpv": "🎵"
    },
    "status-icons": {
      "paused": "▶"
    },
    "ignored-players": ["firefox", "chromium", "brave"]
  },
}
